<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        /* Custom Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        @keyframes zoomIn {
            from {
                transform: scale(0.9);
                opacity: 0;
            }
            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .fadeIn {
            animation: fadeIn 1s ease-in-out;
        }

        .zoomIn {
            animation: zoomIn 1s ease-in-out;
        }
    </style>
</head>
<body class="bg-gray-100 font-sans text-gray-800">

    <!-- Header -->
    <header class="bg-green-600 text-white p-5 flex justify-between items-center flex-wrap">
        <div class="text-xl font-semibold">E-Commerce</div>
        <nav class="flex gap-6 text-lg">
            <a href="#" class="hover:text-yellow-400">Dashboard</a>
            <a href="#" class="hover:text-yellow-400">Products</a>
            <a href="#" class="hover:text-yellow-400">Orders</a>
            <a href="#" class="hover:text-yellow-400">Analytics</a>
            <a href="#" class="hover:text-yellow-400">Settings</a>
        </nav>
    </header>

    <div class="flex p-6 space-x-6">
        <!-- Sidebar -->
        <aside class="bg-white shadow-lg w-1/4 p-6 rounded-lg flex-none">
            <h3 class="text-2xl font-semibold text-green-600 mb-6">Seller Dashboard</h3>
            <ul class="space-y-4">
                <li><a href="#" class="text-green-600 hover:text-yellow-400">Sales Overview</a></li>
                <li><a href="#" class="text-green-600 hover:text-yellow-400">Order Management</a></li>
                <li><a href="#" class="text-green-600 hover:text-yellow-400">Customer Feedback</a></li>
                <li><a href="#" class="text-green-600 hover:text-yellow-400">Promotions</a></li>
            </ul>
        </aside>

        <!-- Main Content -->
        <main class="w-full">
            <!-- Dashboard Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
                <div class="bg-white shadow-lg rounded-lg p-6 space-y-4 fadeIn">
                    <h4 class="text-xl font-semibold text-gray-800">Sales Overview</h4>
                    <p class="text-lg">Total Sales: $25,000</p>
                    <div class="bg-gray-200 h-32 rounded-md mt-4">[Graph]</div>
                </div>
                <div class="bg-white shadow-lg rounded-lg p-6 space-y-4 fadeIn">
                    <h4 class="text-xl font-semibold text-gray-800">Recent Activities</h4>
                    <ul class="space-y-2">
                        <li>New Order from Customer A</li>
                        <li>Shipped Order #12345</li>
                        <li>Price updated for "Product X"</li>
                    </ul>
                </div>
            </div>

            <!-- Product Listings -->
            <div class="mb-8">
                <h4 class="text-2xl font-semibold text-gray-800">Product Listings</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
                    <div class="bg-white shadow-lg rounded-lg p-6 text-center zoomIn">
                        <img src="https://via.placeholder.com/150" alt="Product 1" class="w-full h-40 object-cover mb-4 rounded-lg">
                        <h5 class="text-xl font-semibold">Product 1</h5>
                        <p class="text-lg text-gray-600">$100</p>
                        <button class="bg-green-600 text-white py-2 px-4 mt-4 rounded-full hover:bg-green-700 transition">Edit</button>
                    </div>
                    <div class="bg-white shadow-lg rounded-lg p-6 text-center zoomIn">
                        <img src="https://via.placeholder.com/150" alt="Product 2" class="w-full h-40 object-cover mb-4 rounded-lg">
                        <h5 class="text-xl font-semibold">Product 2</h5>
                        <p class="text-lg text-gray-600">$150</p>
                        <button class="bg-green-600 text-white py-2 px-4 mt-4 rounded-full hover:bg-green-700 transition">Edit</button>
                    </div>
                </div>
                <button class="bg-yellow-400 text-white py-3 px-6 mt-8 rounded-full w-full hover:bg-yellow-500 transition">+ Add New Product</button>
            </div>
        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-green-600 text-white text-center py-4">
        <p>&copy; 2025 E-Commerce Platform</p>
    </footer>

    <script>
        // Add any interactivity here, e.g., for adding a new product
        document.querySelector('button').addEventListener('click', () => {
            alert('Add New Product functionality will be added here!');
        });
    </script>
</body>
</html>
