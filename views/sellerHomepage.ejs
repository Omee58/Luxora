<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="flex h-screen bg-gray-100">
    <div class="w-64 bg-gray-900 text-white p-5">
        <h2 class="text-xl font-bold mb-4">Dashboard</h2>
        <ul>
            <li class="p-2 hover:bg-gray-700 cursor-pointer">Overview</li>
            <li class="p-2 hover:bg-gray-700 cursor-pointer">Orders</li>
            <li class="p-2 hover:bg-gray-700 cursor-pointer">Products</li>
            <li class="p-2 hover:bg-gray-700 cursor-pointer">Customers</li>
            <li class="p-2 hover:bg-gray-700 cursor-pointer">Analytics</li>
            <li class="p-2 hover:bg-gray-700 cursor-pointer">Settings</li>
        </ul>
    </div>
    <div class="flex-1 p-6">
        <div class="flex justify-between items-center bg-white p-4 rounded-lg shadow-md mb-6">
            <h1 class="text-2xl font-semibold">Seller Dashboard</h1>
            <button class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-700">Logout</button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="bg-white p-4 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold mb-2">Sales Overview</h3>
                <div class="h-24 bg-gray-300 rounded"></div>
            </div>
            <div class="bg-white p-4 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold mb-2">Recent Orders</h3>
                <p>Order #1234 - Pending</p>
                <p>Order #1235 - Shipped</p>
            </div>
            <div class="bg-white p-4 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold mb-2">Product Performance</h3>
                <p>Product A - 200 Sales</p>
                <p>Product B - 150 Sales</p>
            </div>
            <div class="bg-white p-4 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold mb-2">Customer Feedback</h3>
                <p>Positive: 90%</p>
                <p>Negative: 10%</p>
            </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md mt-6">
            <h3 class="text-lg font-semibold mb-4">Order Details</h3>
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-gray-900 text-white">
                        <th class="p-2 text-left">Order ID</th>
                        <th class="p-2 text-left">Customer</th>
                        <th class="p-2 text-left">Status</th>
                        <th class="p-2 text-left">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="border-b">
                        <td class="p-2">#1234</td>
                        <td class="p-2">John Doe</td>
                        <td class="p-2">Pending</td>
                        <td class="p-2">$120.00</td>
                    </tr>
                    <tr class="border-b">
                        <td class="p-2">#1235</td>
                        <td class="p-2">Jane Smith</td>
                        <td class="p-2">Shipped</td>
                        <td class="p-2">$85.00</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
