<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />

</head>

<body class="bg-zinc-900 min-h-screen flex flex-col items-center justify-center gap-8 text-white font-sans">

    <div class="text-xl font-medium text-center text-gray-400 mb-12">New Password</div>

    <form action="/updatePassword/updatePassword" method="post"
        class="w-full max-w-md p-8 bg-zinc-800 absolute rounded-lg shadow-xl">

        <!-- Email Field -->


        <div class="mb-6 static ">
            <label for="email" class="block text-lg font-medium text-gray-300">Password</label>
            <input type="password" id="password" oninput="checkPassword()" name="password" required
                placeholder="Enter your Password"
                class="mt-2 p-4 block w-full rounded-lg border-2 border-transparent bg-gray-700 text-gray-300 placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition duration-300" />
            <p class="text-red-700 password-error"></p>
            <!-- transform -translate-y-10 -->
            <button type="button" id="togglePassword" onclick="TogglePassword1()"
                class="absolute top-20 right-12 mt-1 g-blue-600 text-gray-400 hover:text-gray-200">
                <i id="toggleIcon1" class="fas fa-eye-slash"></i>
            </button>
        </div>



        <div class="mb-6 relative">
            <label for="email" class="block text-lg font-medium text-gray-300">Confirm Password</label>
            <input type="password" id="Cpassword" oninput="isPasswordMatch()" name="ConfirmPassword" required
                placeholder="Confirm Password"
                class="mt-2 p-4 block w-full rounded-lg border-2 border-transparent bg-gray-700 text-gray-300 placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none transition duration-300" />
            <p class="text-red-700 confirm-password-error"></p>

            <!-- top-1/2 transform -translate-y-1/2 -->
            <button type="button" id="togglePassword" onclick="TogglePassword2()"
                class="absolute right-4 top-12 mt-1  text-gray-400 hover:text-gray-200">
                <i id="toggleIcon2" class="fas fa-eye-slash"></i>
            </button>
        </div>


        <!-- Submit Button -->
        <button type="submit" id="submitBtn"
            class="w-full px-6 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-300 transform hover:scale-105">
            Continue
        </button>
    </form>

    <script>

        let passwordInput = document.getElementById("password");
        let confirmPasswordInput = document.getElementById("Cpassword");
        const passwordError = document.querySelector(".password-error");
        const confirmPasswordError = document.querySelector(".confirm-password-error");
        const form = document.querySelector("form");
        let isValid = false;

        function checkPassword() {
            let errorMsg = "";

            if (passwordInput.value.length > 0) {
                if (passwordInput.value.length < 8) {
                    errorMsg = "password must be greater than 8 characters.<br/>";
                }
                if (!/[a-z]/.test(passwordInput.value)) {
                    errorMsg +=
                        "Password must contain at least one lowercase letter.<br>";
                }
                if (!/[A-Z]/.test(passwordInput.value)) {
                    errorMsg +=
                        "Password must contain at least one uppercase letter.<br>";
                }
                if (!/[0-9]/.test(passwordInput.value)) {
                    errorMsg += "Password must contain at least one number.<br>";
                }
                if (!/[!@#$%^&*]/.test(passwordInput.value)) {
                    errorMsg +=
                        "Password must contain at least one special character like !@#$%^&*.<br>";
                }

                passwordError.innerHTML = errorMsg;
            }

            if (!errorMsg) {
                isValid = true;
            }

            return isValid;
        }

        function isPasswordMatch() {
            isValid = checkPassword();
            confirmPasswordError.innerHTML = "";
            if (passwordInput.value !== confirmPasswordInput.value) {
                confirmPasswordError.innerHTML = "Passwords do not match";
                isValid = false;
            }

            if (isValid) {
                submitBtn.disabled = false;
                submitBtn.style.cursor = "pointer";
            } else {
                submitBtn.disabled = true;
                submitBtn.style.cursor = "not-allowed";
            }
        }

        form.addEventListener("submit", function (event) {
            if (!isValid) {
                event.preventDefault();
                alert("Try again");
            }
        });


        // this is for Password visibility
        function TogglePassword1() {
            const toggleIcon = document.getElementById('toggleIcon1');
            const passwordField = document.querySelector('#password');

            if (passwordField.type === 'text') {
                passwordField.type = 'password';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordField.type = 'text';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // this is for Confirm  Password visibility
        function TogglePassword2() {
            const toggleIcon = document.getElementById('toggleIcon2');
            const passwordField = document.querySelector('#Cpassword');

            if (passwordField.type === 'text') {
                passwordField.type = 'password';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordField.type = 'text';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

    </script>

</body>

</html>